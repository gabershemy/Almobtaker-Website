# Apache / LiteSpeed Configuration for Almobtaker Alaraby Laravel & Filament
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    RewriteRule ^(\.env|composer\.(json|lock)|auth\.json)$ - [F,L,NC]

    # Handle Deploy Webhook if requested directly
    RewriteRule ^deploy-webhook/?$ deploy-webhook.php [L,QSA]
    RewriteRule ^api/deploy-webhook/?$ deploy-webhook.php [L,QSA]

    # Send Requests to public directory if document root is set to project root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteRule ^(/)?$ public/index.php [L]
</IfModule>
