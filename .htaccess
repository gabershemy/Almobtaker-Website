<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Security: Block direct access to sensitive files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.(?!well-known).* - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L,NC]
    RewriteRule ^vendor/.*\.php$ - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|database\.sqlite.*) - [F,L,NC]
    RewriteRule ^storage/(logs|framework)/ - [F,L,NC]

    # 2. Deploy Webhook Direct Routing
    RewriteRule ^deploy-webhook/?$ deploy-webhook.php [L,QSA]
    RewriteRule ^api/deploy-webhook/?$ deploy-webhook.php [L,QSA]

    # 3. Remove /public/ from URL if typed manually
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # 4. Silently rewrite all other requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
