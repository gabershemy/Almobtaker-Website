# Apache / LiteSpeed Configuration for Almobtaker Alaraby Laravel 13 & Filament v5
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and databases
    RewriteRule ^(\.env.*|\.git.*|database\.sqlite.*|database/.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$ - [F,L,NC]
    RewriteRule ^(storage/(logs|framework)/.*)$ - [F,L,NC]

    # Handle Deploy Webhook if requested directly
    RewriteRule ^deploy-webhook/?$ deploy-webhook.php [L,QSA]
    RewriteRule ^api/deploy-webhook/?$ deploy-webhook.php [L,QSA]

    # Serve public assets directly when hosted in public_html
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send Requests to public directory if document root is set to project root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteRule ^(/)?$ public/index.php [L]
</IfModule>
